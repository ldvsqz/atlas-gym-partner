rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentGymId() {
      return userDoc(request.auth.uid).data.gymId;
    }

    function isAdminForGym(gymId) {
      return hasProfile()
        && userDoc(request.auth.uid).data.rol == 0
        && currentGymId() == gymId;
    }

    function isMemberOfGym(gymId) {
      return hasProfile() && currentGymId() == gymId;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownerUserCreateAllowed(uid) {
      return isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rol == 1
        && request.resource.data.gymId == 'default-gym'
        && request.resource.data.keys().hasOnly([
          'birthday',
          'dni',
          'email',
          'gymId',
          'name',
          'phone',
          'rol',
          'uid',
          'until'
        ]);
    }

    function ownerUserUpdateAllowed(uid) {
      return isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'birthday',
          'dni',
          'email',
          'name',
          'phone',
          'fcmTokens',
          'lastFcmToken',
          'lastTokenUpdated'
        ])
        && request.resource.data.gymId == resource.data.gymId
        && request.resource.data.rol == resource.data.rol;
    }

    function isPublicCycle(cycleId) {
      return exists(/databases/$(database)/documents/cycles/$(cycleId))
        && get(/databases/$(database)/documents/cycles/$(cycleId)).data.public == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid)
        || isAdminForGym(resource.data.gymId);
      allow create: if ownerUserCreateAllowed(uid)
        || isAdminForGym(request.resource.data.gymId);
      allow update: if ownerUserUpdateAllowed(uid)
        || (isAdminForGym(resource.data.gymId)
          && request.resource.data.gymId == resource.data.gymId);
      allow delete: if isAdminForGym(resource.data.gymId);
    }

    match /stats/{statsId} {
      allow read: if isAdminForGym(resource.data.gymId)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdminForGym(request.resource.data.gymId)
        || (signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.gymId == currentGymId());
      allow update: if isAdminForGym(resource.data.gymId)
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.gymId == resource.data.gymId);
      allow delete: if isAdminForGym(resource.data.gymId)
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /routine/{routineId} {
      allow read: if isAdminForGym(resource.data.gymId)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdminForGym(request.resource.data.gymId);
      allow update: if isAdminForGym(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdminForGym(resource.data.gymId);
    }

    match /finances/{movementId} {
      allow read: if isAdminForGym(resource.data.gymId);
      allow create: if isAdminForGym(request.resource.data.gymId);
      allow update: if isAdminForGym(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdminForGym(resource.data.gymId);
    }

    match /monthlyCashboxes/{cashboxId} {
      allow read: if isAdminForGym(resource.data.gymId);
      allow create: if isAdminForGym(request.resource.data.gymId);
      allow update: if isAdminForGym(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdminForGym(resource.data.gymId);
    }

    match /gymExercises/{exerciseId} {
      allow read: if isMemberOfGym(resource.data.gymId);
      allow create: if isAdminForGym(request.resource.data.gymId);
      allow update: if isAdminForGym(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdminForGym(resource.data.gymId);
    }

    match /gymLayouts/{layoutId} {
      allow read: if isMemberOfGym(resource.data.gymId);
      allow create: if isAdminForGym(request.resource.data.gymId);
      allow update: if isAdminForGym(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdminForGym(resource.data.gymId);
    }

    match /cycles/{cycleId} {
      allow read: if resource.data.public == true
        || isAdminForGym(resource.data.gymId);
      allow create: if isAdminForGym(request.resource.data.gymId);
      allow update: if isAdminForGym(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdminForGym(resource.data.gymId);

      match /days/{dayId} {
        allow read: if isPublicCycle(cycleId)
          || isAdminForGym(get(/databases/$(database)/documents/cycles/$(cycleId)).data.gymId);
        allow create, update: if isAdminForGym(
          get(/databases/$(database)/documents/cycles/$(cycleId)).data.gymId
        );
        allow delete: if isAdminForGym(
          get(/databases/$(database)/documents/cycles/$(cycleId)).data.gymId
        );
      }
    }

    match /exercises/{exerciseId} {
      allow read: if isMemberOfGym(resource.data.gymId);
      allow create: if isAdminForGym(request.resource.data.gymId);
      allow update: if isAdminForGym(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdminForGym(resource.data.gymId);
    }

    match /notificados/{notificationId} {
      allow read: if isAdminForGym(resource.data.gymId);
      allow create: if isAdminForGym(request.resource.data.gymId);
      allow update: if isAdminForGym(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdminForGym(resource.data.gymId);
    }

    match /moduleSettings/{settingId} {
      allow read: if isAdminForGym(resource.data.gymId);
      allow create: if isAdminForGym(request.resource.data.gymId);
      allow update: if isAdminForGym(resource.data.gymId)
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if isAdminForGym(resource.data.gymId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
