rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.rol == 0;
    }

    function isAdminForGym(gymId) {
      return isAdmin()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.gymId == gymId;
    }

    match /gyms/{gymId}/gym-exercises/{exerciseId}/{fileName} {
      allow read: if isAdminForGym(gymId);
      allow write: if isAdminForGym(gymId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
